---
// Exit-intent + timed offer capture (no backend — mailto based, free-plan safe).
// Shows once per session: on desktop mouseleave-to-top OR after 35s dwell.
---

<div
  id="exit-modal"
  class="fixed inset-0 z-[90] hidden items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exit-title"
  aria-hidden="true"
>
  <div id="exit-backdrop" class="absolute inset-0 bg-accent-950/60 backdrop-blur-sm"></div>
  <div class="relative w-full max-w-md rounded-3xl border border-brand-100 bg-white p-8 text-center shadow-2xl dark:border-accent-700 dark:bg-accent-900">
    <button
      type="button"
      id="exit-close"
      class="absolute right-3 top-3 inline-flex min-h-12 min-w-12 items-center justify-center rounded-full text-accent-500 hover:bg-accent-100 dark:hover:bg-accent-800"
      aria-label="Close offer dialog"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-600 dark:text-brand-400">Before you go</p>
    <h2 id="exit-title" class="mt-2 font-display text-2xl font-semibold text-accent-900 dark:text-white">
      Interested in phxwax.salon?
    </h2>
    <p class="mt-3 text-sm leading-relaxed text-accent-600 dark:text-accent-300">
      1-of-1 Phoenix beauty domain. Send your offer or questions now — escrow-protected transfer,
      confidential reply in 1–2 business days.
    </p>
    <div class="mt-6 flex flex-col gap-3">
      <a
        href="mailto:sales@desertrich.com?subject=Domain%20Offer%3A%20phxwax.salon%20(exit%20intent)&body=Hello%2C%0A%0AI%27d%20like%20to%20discuss%20phxwax.salon.%0A%0AOffer%20(USD)%3A%20%0ATimeline%3A%20%0A%0AThank%20you."
        data-cta="exit-intent-offer"
        class="btn-primary w-full"
      >
        Email Your Offer
      </a>
      <button
        type="button"
        id="exit-dismiss"
        class="inline-flex min-h-12 items-center justify-center text-sm font-medium text-accent-500 underline-offset-4 hover:underline dark:text-accent-400"
      >
        Continue browsing
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'phx-exit-seen';
    var modal = document.getElementById('exit-modal');
    if (!modal) return;
    try {
      if (sessionStorage.getItem(KEY)) return;
    } catch (e) {}

    var shown = false;
    function show() {
      if (shown) return;
      shown = true;
      try { sessionStorage.setItem(KEY, '1'); } catch (e) {}
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      modal.setAttribute('aria-hidden', 'false');
      var close = document.getElementById('exit-close');
      if (close) close.focus();
    }
    function hide() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      modal.setAttribute('aria-hidden', 'true');
    }

    // Desktop exit intent: mouse leaves viewport at top
    document.addEventListener('mouseout', function (e) {
      if (!e.relatedTarget && e.clientY <= 8) show();
    });
    // Fallback: timed nudge after 35s
    setTimeout(show, 35000);

    var c1 = document.getElementById('exit-close');
    var c2 = document.getElementById('exit-dismiss');
    var bd = document.getElementById('exit-backdrop');
    if (c1) c1.addEventListener('click', hide);
    if (c2) c2.addEventListener('click', hide);
    if (bd) bd.addEventListener('click', hide);
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') hide();
    });
  })();
</script>
