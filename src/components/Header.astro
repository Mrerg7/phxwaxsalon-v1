---
const navLinks = [
  { href: '#about', label: 'About' },
  { href: '#services', label: 'Services' },
  { href: '#why', label: 'Why Us' },
];
---

<header class="sticky top-0 z-50 border-b border-brand-100/80 bg-brand-50/90 backdrop-blur-md">
  <div class="container-narrow">
    <div class="flex h-16 items-center justify-between sm:h-18">
      <a href="/" class="group flex min-h-11 items-center gap-2.5" aria-label="PHX Wax Salon home">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-brand-600 text-white shadow-sm transition-transform group-hover:scale-105">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364 1.636l-1.591 1.591M21 12h-2.25m-1.636 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="font-display text-lg font-semibold tracking-tight text-accent-900">PHX Wax</span>
          <span class="-mt-1 text-[10px] font-medium uppercase tracking-widest text-brand-600">Salon</span>
        </div>
      </a>

      <nav class="hidden items-center gap-8 sm:flex" aria-label="Main navigation">
        {navLinks.map((link) => (
          <a href={link.href} class="text-sm font-medium text-accent-700 transition-colors hover:text-brand-700">
            {link.label}
          </a>
        ))}
        <a href="#acquisition" class="btn-primary min-h-11 px-5 py-3 text-xs">Domain Inquiry</a>
      </nav>

      <button
        type="button"
        id="mobile-menu-btn"
        class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg p-2.5 text-accent-700 hover:bg-brand-100 sm:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle menu"
      >
        <svg id="menu-icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-brand-100 bg-brand-50 sm:hidden">
    <div class="container-narrow space-y-1 py-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="block min-h-11 rounded-lg px-3 py-3 text-base font-medium text-accent-800 hover:bg-brand-100"
        >
          {link.label}
        </a>
      ))}
      <a
        href="#acquisition"
        class="mt-2 flex min-h-11 items-center justify-center rounded-full bg-brand-600 px-4 py-3 text-center text-sm font-semibold text-white"
      >
        Domain Inquiry
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (btn && menu) {
    const setOpen = (open) => {
      menu.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', open.toString());
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
    };

    btn.addEventListener('click', () => {
      setOpen(menu.classList.contains('hidden'));
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
  }
</script>
