        </div>
        <div class="reveal mx-auto mt-8 max-w-3xl rounded-2xl border border-brand-200 bg-white p-6 text-left dark:border-accent-700 dark:bg-accent-950 sm:p-8">
          <h3 class="text-base font-semibold text-accent-900 dark:text-white">Comparable positioning</h3>
          <p class="mt-2 text-sm leading-relaxed text-accent-600 dark:text-accent-300">
