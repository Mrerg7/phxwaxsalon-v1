<script is:inline>
  (function () {
    // Urgency: lightweight viewer counter (local, no backend — free plan safe)
    try {
      var key = 'phx-views';
      var n = parseInt(localStorage.getItem(key) || '0', 10) + 1;
      localStorage.setItem(key, String(n));
      var el = document.getElementById('viewer-count');
      if (el) {
        var base = 14 + (n % 23);
        el.textContent = base + ' viewing this week';
        el.classList.remove('hidden');
      }
    } catch (e) {}

    // FAQ client-side search (replaces marketplace filter for single-domain site)
    var input = document.getElementById('faq-search');
    var cards = Array.prototype.slice.call(document.querySelectorAll('#faq-list details'));
    var empty = document.getElementById('faq-empty');
    if (input) {
      input.addEventListener('input', function () {
        var q = input.value.trim().toLowerCase();
        var shown = 0;
        cards.forEach(function (card) {
          var hay = ((card.getAttribute('data-faq') || '') + ' ' + (card.textContent || '')).toLowerCase();
          var ok = !q || hay.indexOf(q) !== -1;
          card.style.display = ok ? '' : 'none';
          if (ok) { shown++; if (q) card.open = true; }
        });
        if (empty) empty.classList.toggle('hidden', shown !== 0);
      });
    }
  })();
</script>
