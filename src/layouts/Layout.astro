---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title = 'phxwax.salon | Premium Domain for Sale | PHX Wax Salon',
  description = 'phxwax.salon for sale — premium Phoenix Brazilian wax domain. Exact-match local intent for salon, spa & beauty brands. Make an offer via escrow-protected transfer. Contact sales@desertrich.com.',
  ogImage = 'https://phxwax.salon/og-image.svg',
  canonical = 'https://phxwax.salon/',
} = Astro.props;

const siteName = 'PHX Wax Salon';
const dateModified = '2026-10-03';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" type="application/xml" />

    <!-- Performance: preconnect + non-blocking fonts (replaces CSS @import) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      />
    </noscript>

    <!-- Google Search Console -->
    <meta name="google-site-verification" content="in4mLA3h4apCxLefgAYLIBZEtzUyO5MS11oWFyVbxh0" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="phxwax.salon — Premium Domain for Sale" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="phxwax.salon — Premium Domain for Sale" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#b5624c" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#22262f" media="(prefers-color-scheme: dark)" />

    <!-- Prevent dark-mode FOUC (class strategy, localStorage, free-plan friendly) -->
    <script is:inline>
      try {
        document.documentElement.classList.add('js');
        var t = localStorage.getItem('phx-theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      } catch (e) {
        document.documentElement.classList.add('js');
      }
    </script>
    <noscript>
      <style>
        .reveal { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>

    <!-- Structured Data: Organization -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "@id": "https://phxwax.salon/#org",
      "name": "PHX Wax Salon",
      "url": "https://phxwax.salon/",
      "logo": "https://phxwax.salon/favicon.svg",
      "email": "sales@desertrich.com",
      "areaServed": { "@type": "City", "name": "Phoenix, Arizona" }
    })} />

    <!-- Structured Data: WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "https://phxwax.salon/#website",
      "name": siteName,
      "url": "https://phxwax.salon/",
      "description": description,
      "publisher": { "@id": "https://phxwax.salon/#org" },
      "inLanguage": "en-US"
    })} />

    <!-- Structured Data: WebPage + Breadcrumb -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "@id": canonical + "#webpage",
      "name": title,
      "description": description,
      "url": canonical,
      "isPartOf": { "@id": "https://phxwax.salon/#website" },
      "about": {
        "@type": "Thing",
        "name": "Brazilian Wax Salon Phoenix",
        "description": "Professional Brazilian wax services using hard wax techniques for sensitive areas, delivering smooth skin for 3 to 4 weeks."
      },
      "datePublished": "2026-07-29",
      "dateModified": dateModified,
      "inLanguage": "en-US"
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://phxwax.salon/" },
        { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://phxwax.salon/#services" },
        { "@type": "ListItem", "position": 3, "name": "FAQ", "item": "https://phxwax.salon/#faq" },
        { "@type": "ListItem", "position": 4, "name": "Acquire Domain", "item": "https://phxwax.salon/#acquisition" }
      ]
    })} />

    <!-- Structured Data: Product (domain name for sale) — mirrors visible acquisition section -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      "@id": "https://phxwax.salon/#domain-product",
      "name": "phxwax.salon — Premium Domain for Sale",
      "description": "Premium exact-match domain for a Phoenix Brazilian wax salon, spa, or beauty brand. Escrow-protected transfer. Serious inquiries: sales@desertrich.com.",
      "url": "https://phxwax.salon/#acquisition",
      "brand": { "@type": "Brand", "name": "PHX Wax Salon" },
      "category": "Domain Name",
      "image": ogImage,
      "offers": {
        "@type": "Offer",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": "https://phxwax.salon/#acquisition",
        "seller": { "@id": "https://phxwax.salon/#org" }
      }
    })} />

    <!-- Structured Data: FAQPage — MUST match visible #faq content -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Brazilian waxing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Brazilian waxing is a precise hair removal method that extracts hair from the root using warm or hard wax, providing smooth results for 3 to 4 weeks. Hard wax is preferred for sensitive areas because it adheres only to the hair, not the skin."
          }
        },
        {
          "@type": "Question",
          "name": "How long do results last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Professional Brazilian wax services typically deliver smooth skin for 3 to 4 weeks. With consistent sessions, regrowth often becomes finer over time."
          }
        },
        {
          "@type": "Question",
          "name": "Why choose hard wax in Phoenix?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hard wax is ideal for the bikini line and underarms. It grips the hair shaft while releasing cleanly from the skin, reducing irritation — especially valuable in the Arizona climate."
          }
        },
        {
          "@type": "Question",
          "name": "Is phxwax.salon available for purchase?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. phxwax.salon is available for acquisition via private escrow-protected transfer. Email sales@desertrich.com with your offer. All discussions are confidential with a 1–2 business day response."
          }
        }
      ]
    })} />
  </head>
  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-white focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:shadow-lg"
    >
      Skip to content
    </a>
    <slot />

    <script is:inline data-phx-reveal>
      // Scroll-triggered fade-ins. Runs after <slot /> so ALL page content
      // is parsed (header-only scripts run too early and see an empty DOM).
      (function () {
        function init() {
          var els = document.querySelectorAll('.reveal');
          if (!els.length) return;
          if (!('IntersectionObserver' in window)) {
            els.forEach(function (el) { el.classList.add('is-visible'); });
            return;
          }
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) {
                en.target.classList.add('is-visible');
                io.unobserve(en.target);
              }
            });
          }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });
          els.forEach(function (el) {
            // Already in view on load (e.g. hero pill) → show immediately
            var r = el.getBoundingClientRect();
            if (r.top < window.innerHeight && r.bottom > 0) {
              el.classList.add('is-visible');
            } else {
              io.observe(el);
            }
          });
          // Safety net: never leave content invisible (JS edge cases)
          setTimeout(function () {
            document.querySelectorAll('.reveal:not(.is-visible)').forEach(function (el) {
              el.classList.add('is-visible');
            });
          }, 2500);
        }
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', init);
        } else {
          init();
        }
      })();
    </script>
    <script is:inline data-cf-conversion>
      // Lightweight conversion tracking hook (free-plan friendly, no PII).
      // Emits CustomEvent('phx_cta', {detail:{cta}}) consumed by analytics if present.
      document.addEventListener('click', function (e) {
        var el = e.target && e.target.closest ? e.target.closest('[data-cta]') : null;
        if (!el) return;
        var name = el.getAttribute('data-cta') || 'cta';
        try {
          document.dispatchEvent(new CustomEvent('phx_cta', { detail: { cta: name, href: el.getAttribute('href') } }));
          if (window.plausible) window.plausible('CTA:' + name);
          if (window.gtag) window.gtag('event', 'cta_click', { cta_name: name });
        } catch (err) {}
      });
    </script>
  </body>
</html>
