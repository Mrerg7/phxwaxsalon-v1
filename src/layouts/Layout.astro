---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title = 'PHX Wax Salon | Premium Brazilian Wax in Phoenix',
  description = 'Discover professional Brazilian wax services in Phoenix. Expert techniques, hard wax for sensitive areas, and lasting smooth results for 3–4 weeks.',
  ogImage = 'https://phxwax.salon/og-image.png',
  canonical = 'https://phxwax.salon/',
} = Astro.props;

const siteName = 'PHX Wax Salon';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />

    <!-- Google Search Console -->
    <meta name="google-site-verification" content="in4mLA3h4apCxLefgAYLIBZEtzUyO5MS11oWFyVbxh0" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#c97d64" />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": siteName,
      "url": "https://phxwax.salon",
      "description": description,
      "publisher": {
        "@type": "Organization",
        "name": "PHX Wax Salon",
        "url": "https://phxwax.salon"
      }
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": title,
      "description": description,
      "url": canonical,
      "isPartOf": {
        "@type": "WebSite",
        "name": siteName,
        "url": "https://phxwax.salon"
      },
      "about": {
        "@type": "Thing",
        "name": "Brazilian Wax Salon Phoenix",
        "description": "Professional Brazilian wax services using hard wax techniques for sensitive areas, delivering smooth skin for 3 to 4 weeks."
      },
      "datePublished": "2026-07-29",
      "dateModified": "2026-07-29",
      "inLanguage": "en-US"
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Brazilian waxing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Brazilian waxing is a precise hair removal method that extracts hair from the root using warm or hard wax, providing smooth results for 3 to 4 weeks. Hard wax is preferred for sensitive areas because it adheres only to the hair, not the skin."
          }
        },
        {
          "@type": "Question",
          "name": "How long do results last?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Professional Brazilian wax services typically deliver smooth skin for 3 to 4 weeks. With consistent sessions, regrowth often becomes finer over time."
          }
        },
        {
          "@type": "Question",
          "name": "Why choose hard wax in Phoenix?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Hard wax is ideal for the bikini line and underarms. It grips the hair shaft while releasing cleanly from the skin, reducing irritation—especially valuable in the Arizona climate."
          }
        }
      ]
    })} />
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
  </body>
</html>
